<IfModule mod_rewrite.c>
RewriteEngine On
# Route authentication through CodeIgniter even if a same-named directory exists.
RewriteRule ^(authentication(?:/.*)?)$ index.php?/$1 [L,QSA,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
